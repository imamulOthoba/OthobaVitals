<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and animation duration. -->
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>

        <!-- Use the monochrome vector icon you created for the mobile app, assuming it's copied or shared.
             We will copy ic_launcher_monochrome.xml to the TV module as well. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_monochrome</item>

        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <item name="postSplashScreenTheme">@style/Theme.OthobaVitals</item>
    </style>
</resources>